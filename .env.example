# Copy to .env and set real values. .env is gitignored; this file is the template.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# The prod profile refuses to start while admin123 / driver123 still work. Set this to
# true only if this instance is deliberately open - a viva, a walkthrough, a throwaway box.
YBS_ALLOW_DEMO_LOGINS=false
